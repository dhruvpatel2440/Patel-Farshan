# Copy this file to .env.local and fill in your real values.
# Never commit .env.local — it's already in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_UPI_ID=yourname@okaxis
NEXT_PUBLIC_SHOP_NAME=Patel Farsan
NEXT_PUBLIC_SHOP_PHONE=+919876543210
NEXT_PUBLIC_SHOP_WHATSAPP=919876543210

# Optional — order confirmation + contact-form emails
RESEND_API_KEY=re_xxxxxxxxxxxx
# The shop's real inbox — where contact-form submissions land.
RESEND_FROM_EMAIL=orders@patelfarsan.in
# Sender identity Resend actually accepts mail "from". Until you verify a
# custom domain at resend.com/domains, leave this unset — it defaults to
# Resend's shared "onboarding@resend.dev" sender, which works with zero
# setup. Sending "from" an unverified domain (e.g. a Gmail address) is
# rejected with a 403.
# RESEND_FROM_ADDRESS=Patel Farsan <onboarding@resend.dev>
