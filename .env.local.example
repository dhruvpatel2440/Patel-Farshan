# Optional — order confirmation + contact-form emails, sent via Brevo
# (brevo.com). Free tier: 300 emails/day, no domain/DNS setup required —
# just verify one sender address in Brevo (Settings -> Senders, Domains &
# Dedicated IPs -> Senders -> Add a sender) and generate an API key
# (Settings -> SMTP & API -> API Keys).
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must exactly match the address you verified in Brevo.
BREVO_SENDER_EMAIL=patelfarshan1985@gmail.com
BREVO_SENDER_NAME=Patel Farsan
# Where contact-form submissions land. Defaults to BREVO_SENDER_EMAIL if unset.
# CONTACT_TO_EMAIL=patelfarshan1985@gmail.com

# Optional — pulls your shop's Google Business Profile reviews into the
# admin Feedback page and the homepage testimonials marquee.
# Setup: console.cloud.google.com -> create/select a project -> enable
# "Places API (New)" -> enable billing (Google requires a card on file even
# though usage this light stays inside the free monthly credit) -> Credentials
# -> Create API key. Restrict the key to "Places API (New)" only.
# GOOGLE_PLACES_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Find your Place ID at developers.google.com/maps/documentation/places/web-service/place-id
# (search your shop by name/address there).
# GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxxxxx
#
# Hard limits from Google, not fixable here: the API returns at most 5
# reviews (Google's own "most relevant" picks, no way to request more or
# page through the rest), and review content may not be cached past 30 days
# per Google's ToS — this app refreshes every 24h.
