# Copy this file to .env.local and fill in your real values.
# Never commit .env.local — it's already in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required server-only secrets. Generate each with: openssl rand -hex 32
# Signs the admin step-up session cookie. Changing it logs every admin out.
ADMIN_SESSION_SECRET=
# Mixed into the SHA-256 of every emailed one-time code, so a leaked hash
# cannot be brute-forced. Changing it invalidates codes already in flight.
OTP_PEPPER=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_UPI_ID=yourname@okaxis
NEXT_PUBLIC_SHOP_NAME=Patel Farsan
NEXT_PUBLIC_SHOP_PHONE=+919876543210
NEXT_PUBLIC_SHOP_WHATSAPP=919876543210

# Optional — order confirmation + contact-form emails, sent via Brevo
# (brevo.com). Free tier: 300 emails/day, no domain/DNS setup required —
# just verify one sender address in Brevo (Settings -> Senders, Domains &
# Dedicated IPs -> Senders -> Add a sender) and generate an API key
# (Settings -> SMTP & API -> API Keys).
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must exactly match the address you verified in Brevo.
BREVO_SENDER_EMAIL=patelfarshan1985@gmail.com
BREVO_SENDER_NAME=Patel Farsan
# Where contact-form submissions land. Defaults to BREVO_SENDER_EMAIL if unset.
# CONTACT_TO_EMAIL=patelfarshan1985@gmail.com
